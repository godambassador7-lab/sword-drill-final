REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
REACT_APP_ESV_API_KEY=YOUR_CROSSWAY_ESV_API_KEY

# Qwen uses the serverless /api/qwen route. Never prefix the secret with REACT_APP_.
REACT_APP_ENABLE_QWEN=false

# Production recommendation: Cloudflare Workers AI
SHARP_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_AI_TOKEN=YOUR_CLOUDFLARE_WORKERS_AI_TOKEN
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# Local development alternative: set SHARP_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_MAX_TOKENS=600

# Optional Alibaba fallback: set SHARP_AI_PROVIDER=dashscope
DASHSCOPE_API_KEY=YOUR_ALIBABA_CLOUD_MODEL_STUDIO_API_KEY
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
